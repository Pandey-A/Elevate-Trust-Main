PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://et-revamp-2-1.vercel.app
# If PORT is busy, backend auto-tries the next ports (up to PORT_TRIES)
PORT_TRIES=20

# Supabase Postgres (preferred)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

DB_HOST=db.YOUR_PROJECT.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# Cloudinary — use an UNRESTRICTED API key (Create/Upload enabled)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth
JWT_SECRET=change-this-to-a-long-random-string

PUBLIC_API_URL=http://localhost:5000

# Contact / newsletter lead email (Microsoft Graph API — Mail.Send)
# Azure App Registration: Application permission Mail.Send + admin consent
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret-value
# Licensed mailbox in your tenant that the app sends as
CONTACT_FROM_EMAIL=gaurav.sharma@elevatetrust.ai
CONTACT_TO_EMAIL=info@elevatetrust.ai


# changes are done here for testing purpose
