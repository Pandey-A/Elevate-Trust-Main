PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://elevatetrust.co.in,https://www.elevatetrust.co.in,https://app.elevatetrust.co.in
# Optional regex patterns for preview/subdomains (comma-separated)
# Example: ^https://.*\.elevatetrust\.co\.in$
CORS_ORIGIN_PATTERNS=^https://.*\.elevatetrust\.co\.in$
# If PORT is busy, backend auto-tries the next ports (up to PORT_TRIES)
PORT_TRIES=20

# -----------------------------------------------------------------------------
# PostgreSQL Database (AWS RDS, AWS Lightsail, Docker, or Local)
# -----------------------------------------------------------------------------
# Option 1: Standard Connection String URL
# AWS RDS / Aurora:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@your-rds-instance.xxxxxx.us-east-1.rds.amazonaws.com:5432/elevate_trust
# AWS EC2 / Lightsail Docker ($0 extra DB cost):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/elevate_trust
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elevate_trust

# Option 2: Individual Connection Parameters (used if DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elevate_trust
DB_USER=postgres
DB_PASSWORD=postgres

# SSL Configuration:
# - AWS RDS / Cloud: true (or require)
# - Local / Docker container: false (or disable)
DB_SSL=false
# Set true only if you provide a full CA bundle to verify the RDS root certificate
DB_SSL_REJECT_UNAUTHORIZED=false

# Connection Pool Tuning (AWS burstable & container optimization)
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# Authentication & Cookies
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string

# Cookie Management on AWS / Production:
# - Same-Origin / Nginx reverse proxy: leave COOKIE_DOMAIN empty
# - Subdomains (e.g. app.elevatetrust.co.in & api.elevatetrust.co.in): set COOKIE_DOMAIN=.elevatetrust.co.in
# - Localhost: leave empty
COOKIE_DOMAIN=
# Options: lax (recommended for same-site / top-level navigation), strict, none (requires HTTPS)
COOKIE_SAMESITE=lax
# Secure cookie (auto-true in production; set false only if running HTTP in prod)
COOKIE_SECURE=true

# PUBLIC_API_URL=http://localhost:5000
PUBLIC_APP_URL=https://elevatetrust.co.in
# Behind reverse proxies (AWS ALB, CloudFront, Nginx), trust X-Forwarded-* headers.
TRUST_PROXY=1

# -----------------------------------------------------------------------------
# File & Media Storage (Cost Optimization)
# -----------------------------------------------------------------------------
# To avoid third-party SaaS fees ($89/month Cloudinary fee), set ALLOW_LOCAL_STORAGE=true.
# On AWS EC2 or Lightsail with persistent EBS disk, files are saved locally to /uploads and served via Nginx/Express ($0 SaaS cost).
ALLOW_LOCAL_STORAGE=true
STORAGE_DRIVER=local

# Optional Cloudinary (if you still wish to use Cloudinary CDN instead of local disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Request body limits (blog HTML and media)
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=10mb

# -----------------------------------------------------------------------------
# Dashboard Seed Users
# -----------------------------------------------------------------------------
# Auto on server start:
# - SEED_ON_START=true  -> always upsert these users from env (first deploy)
# - SEED_ON_START=false -> seed only when DB has zero admin users
SEED_ON_START=false

# Admin (Full Dashboard Management)
SEED_ADMIN_1_EMAIL=sid@elevatetrust.ai
SEED_ADMIN_1_NAME=Sid
SEED_ADMIN_1_PASSWORD=Admin@2026

# View Users (Demos/Dashboard View Only)
SEED_SALES_1_EMAIL=sachin@elevatetrust.ai
SEED_SALES_1_NAME=Sachin
SEED_SALES_1_PASSWORD=sachin@2026

SEED_SALES_2_EMAIL=diksha@elevatetrust.ai
SEED_SALES_2_NAME=Diksha
SEED_SALES_2_PASSWORD=diksha@2026

SEED_SALES_3_EMAIL=parag@elevatetrust.ai
SEED_SALES_3_NAME=Parag
SEED_SALES_3_PASSWORD=parag@2026

# -----------------------------------------------------------------------------
# Contact & Newsletter Emails
# -----------------------------------------------------------------------------
# Option A: Microsoft Graph API
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
CONTACT_FROM_EMAIL=info@elevatetrust.ai
CONTACT_TO_EMAIL=info@elevatetrust.ai
