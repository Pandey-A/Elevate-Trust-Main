PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://et-revamp-2-1.vercel.app,https://elevatetrust.ai,https://www.elevatetrust.ai
# Optional regex patterns for preview/custom domains (comma-separated)
# Example: ^https://et-revamp.*\.vercel\.app$
CORS_ORIGIN_PATTERNS=
# If PORT is busy, backend auto-tries the next ports (up to PORT_TRIES)
PORT_TRIES=20

# Supabase Postgres (preferred)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Explicit SSL for hosted Postgres (true/require/false). If unset, supabase.co hosts enable SSL.
DB_SSL=true

DB_HOST=db.YOUR_PROJECT.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# Cloudinary — required in production (Create/Upload enabled)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth
JWT_SECRET=change-this-to-a-long-random-string

PUBLIC_API_URL=http://localhost:5000
# Behind reverse proxies (Vercel/Render/Nginx), trust X-Forwarded-* headers.
# Use 1 for a single proxy hop, or true when appropriate.
TRUST_PROXY=1

# Request body limits (blog HTML can exceed the old 32kb default)
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=10mb

# -----------------------------------------------------------------------------
# Dashboard seed (deploy team — set these on Render / production env)
# 5 slots: 2 admin + 3 sales. Passwords: set real values in host env only;
# never commit real passwords to git.
#
# Auto on server start:
# - SEED_ON_START=true  → always upsert these users from env (use on first
#   deploy / new DB, then set false so redeploys do not reset passwords)
# - SEED_ON_START unset/false → seed only when DB has zero admin users
# Manual: npm run db:seed
# -----------------------------------------------------------------------------
SEED_ON_START=false

# Admin 1 (full dashboard)
SEED_ADMIN_1_EMAIL=admin1@elevatetrust.ai
SEED_ADMIN_1_NAME=Admin One
SEED_ADMIN_1_PASSWORD=change-me-admin1-password

# Admin 2 (full dashboard)
SEED_ADMIN_2_EMAIL=admin2@elevatetrust.ai
SEED_ADMIN_2_NAME=Admin Two
SEED_ADMIN_2_PASSWORD=change-me-admin2-password

# Sales 1–3 (demos view only) — optional; omit a slot to skip it
SEED_SALES_1_EMAIL=sales1@elevatetrust.ai
SEED_SALES_1_NAME=Sales One
SEED_SALES_1_PASSWORD=change-me-sales1-password

SEED_SALES_2_EMAIL=sales2@elevatetrust.ai
SEED_SALES_2_NAME=Sales Two
SEED_SALES_2_PASSWORD=change-me-sales2-password

SEED_SALES_3_EMAIL=sales3@elevatetrust.ai
SEED_SALES_3_NAME=Sales Three
SEED_SALES_3_PASSWORD=change-me-sales3-password

# Legacy single-admin keys (optional fallback for Admin 1 if SEED_ADMIN_1_* unset)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=
# SEED_ADMIN_PASSWORD=

# Contact / newsletter lead email (Microsoft Graph API — Mail.Send)
# Azure App Registration: Application permission Mail.Send + admin consent
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret-value
# Licensed mailbox in your tenant that the app sends as
CONTACT_FROM_EMAIL=gaurav.sharma@elevatetrust.ai
CONTACT_TO_EMAIL=info@elevatetrust.ai
