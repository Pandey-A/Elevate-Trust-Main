PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://et-revamp-2-1.vercel.app,https://elevatetrust.ai,https://www.elevatetrust.ai
# Optional regex patterns for preview/custom domains (comma-separated)
# Example: ^https://et-revamp.*\.vercel\.app$
CORS_ORIGIN_PATTERNS=
# If PORT is busy, backend auto-tries the next ports (up to PORT_TRIES)
PORT_TRIES=20

# Supabase Postgres (preferred)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Explicit SSL for hosted Postgres (true/require/false). If unset, supabase.co hosts enable SSL.
DB_SSL=true

DB_HOST=db.YOUR_PROJECT.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# Cloudinary — required in production (Create/Upload enabled)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth
JWT_SECRET=change-this-to-a-long-random-string

PUBLIC_API_URL=http://localhost:5000
# Behind reverse proxies (Vercel/Render/Nginx), trust X-Forwarded-* headers.
# Use 1 for a single proxy hop, or true when appropriate.
TRUST_PROXY=1

# Request body limits (blog HTML can exceed the old 32kb default)
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=10mb

# Dashboard seed credentials (never commit real passwords)
SEED_ADMIN_EMAIL=admin@elevatetrust.ai
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=change-me-admin-password
# Optional sales users
# SEED_SALES_1_EMAIL=sales1@elevatetrust.ai
# SEED_SALES_1_NAME=Sales One
# SEED_SALES_1_PASSWORD=change-me-sales-password

# Contact / newsletter lead email (Microsoft Graph API — Mail.Send)
# Azure App Registration: Application permission Mail.Send + admin consent
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret-value
# Licensed mailbox in your tenant that the app sends as
CONTACT_FROM_EMAIL=gaurav.sharma@elevatetrust.ai
CONTACT_TO_EMAIL=info@elevatetrust.ai
